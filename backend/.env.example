# 环境变量配置文件模板
# 复制此文件为 .env 并填入实际的值

# ========== 火山引擎API配置 ==========
# 火山引擎API密钥（用于翻译和语音识别）
VOLC_API_KEY=your_volc_api_key_here

# 火山引擎APP ID（语音识别和自动打轴API）
VOLC_APP_ID=your_app_id_here

# 火山引擎访问令牌（语音识别和自动打轴API）
VOLC_ACCESS_TOKEN=your_access_token_here

# ========== 豆包API配置 ==========
# 豆包大模型API密钥
DOUBAO_API_KEY=your_doubao_api_key_here

# 豆包模型名称（可选，默认值：doubao-seed-2-0-pro-260215）
DOUBAO_MODEL=doubao-seed-2-0-pro-260215

# ========== 服务器配置 ==========
# 服务器端口（可选，默认：3001）
PORT=3001

# 运行环境：development, test, production（可选，默认：development）
NODE_ENV=development

# ========== 本地翻译服务配置 ==========
# 是否使用本地腾讯混元翻译模型（true/false，默认：false）
USE_LOCAL_TRANSLATE=false

# 本地翻译服务地址（默认：http://127.0.0.1:5001/translate）
LOCAL_TRANSLATE_URL=http://127.0.0.1:5001/translate

# ========== 其他配置 ==========
# FFmpeg路径（可选，系统会自动查找）
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe